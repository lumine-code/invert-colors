{
  "name": "invert-colors",
  "author": "lumine-code",
  "description": "Invert view colors for images, editors, and the PDF view.",
  "repository": "https://github.com/lumine-code/invert-colors",
  "bugs": {
    "url": "https://github.com/lumine-code/invert-colors/issues"
  },
  "keywords": [
    "image",
    "dark-mode",
    "pdf",
    "night",
    "accessibility"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "status-bar"
  ],
  "main": "./lib/main.js",
  "files": [
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "pdf-view": {
      "versions": {
        "^1.0.0": "consumePdfView"
      }
    },
    "status-bar": {
      "versions": {
        "^2.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "statusIcon": {
      "title": "Status icon",
      "description": "Show one status bar icon with an indicator for each inversion mode.",
      "type": "boolean",
      "default": false
    },
    "workspaceState": {
      "title": "Workspace state",
      "description": "Invert colors of whole workspace",
      "type": "boolean",
      "default": false
    },
    "editorState": {
      "title": "Editor state",
      "description": "Invert colors of text editors",
      "type": "boolean",
      "default": false
    },
    "imageState": {
      "title": "Image state",
      "description": "Invert colors of images",
      "type": "boolean",
      "default": false
    },
    "pdfViewState": {
      "title": "PDF view state",
      "description": "Invert colors of pdf-view instances",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
